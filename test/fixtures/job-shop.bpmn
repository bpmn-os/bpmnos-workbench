      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_0gkimz7_di" bpmnElement="Participant_0gkimz7" isHorizontal="true">
        <dc:Bounds x="330" y="-280" width="770" height="380" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
