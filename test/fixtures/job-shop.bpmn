<?xml version="1.0" encoding="UTF-8"?>
<!--
  The job shop scheduling model of BPMNOSInstances.jl, copied here so that the tests read a real model: a
  collaboration of two participants, each declaring the keyword attributes of its own process, with a
  multi-instance sub-process in one and an event sub-process holding an ad-hoc sub-process in the other.

  One edit was made to the copy. The restriction `Condition_05rdls5` carried `parameter="[object Object]"`,
  a stringified object written into an attribute the schema does not define, which is a defect of the model
  in that repository rather than of anything read here.
-->
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmnos="https://bpmnos.telematique.eu" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <bpmn2:collaboration id="Job_shop_scheduling_problem">
    <bpmn2:extensionElements>
      <bpmnos:attributes>
        <bpmnos:attribute id="Makespan" type="decimal" name="makespan := 0" objective="minimize" weight="1" />
      </bpmnos:attributes>
    </bpmn2:extensionElements>
    <bpmn2:participant id="Participant_1c07lhk" name="Job process" processRef="JobProcess" />
    <bpmn2:participant id="Participant_0gkimz7" name="Machine process" processRef="MachineProcess" />
    <bpmn2:messageFlow id="Flow_1yu534x" sourceRef="RequestTask" targetRef="CatchRequestMessage" />
    <bpmn2:messageFlow id="Flow_186vkn6" sourceRef="ThrowCompletionMessage" targetRef="NoticeTaskCompletion" />
  </bpmn2:collaboration>
  <bpmn2:process id="JobProcess" isExecutable="true">
    <bpmn2:extensionElements>
      <bpmnos:status>
        <bpmnos:attributes>
          <bpmnos:attribute id="Timestamp" type="decimal" name="timestamp" />
        </bpmnos:attributes>
      </bpmnos:status>
    </bpmn2:extensionElements>
    <bpmn2:dataObject id="DataObject_1xt50y3">
      <bpmn2:extensionElements>
        <bpmnos:attributes>
          <bpmnos:attribute id="Instance" type="string" name="instance" />
        </bpmnos:attributes>
      </bpmn2:extensionElements>
    </bpmn2:dataObject>
    <bpmn2:startEvent id="StartEventItem">
      <bpmn2:outgoing>Flow_1qgy5y7</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:endEvent id="Event_0pouiab">
      <bpmn2:incoming>Flow_0xaxr01</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:subProcess id="TaskActivity">
      <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:attributes>
            <bpmnos:attribute id="Index" type="integer" name="index" />
            <bpmnos:attribute id="RequestedMachine" type="string" name="machine := machines[index]" />
            <bpmnos:attribute id="Duration" type="decimal" name="duration := durations[index]" />
          </bpmnos:attributes>
        </bpmnos:status>
        <bpmnos:loopCharacteristics>
          <bpmnos:parameter name="index" value="index" />
          <bpmnos:parameter name="cardinality" value="count(machines)" />
        </bpmnos:loopCharacteristics>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_1qgy5y7</bpmn2:incoming>
      <bpmn2:outgoing>Flow_0xaxr01</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn2:startEvent id="JobStartEvent">
        <bpmn2:outgoing>Flow_06kzyqb</bpmn2:outgoing>
      </bpmn2:startEvent>
      <bpmn2:endEvent id="JobEndEvent">
        <bpmn2:incoming>Flow_05lm3ex</bpmn2:incoming>
      </bpmn2:endEvent>
      <bpmn2:sequenceFlow id="Flow_06kzyqb" sourceRef="JobStartEvent" targetRef="RequestTask" />
      <bpmn2:sendTask id="RequestTask" name="Send request">
        <bpmn2:extensionElements>
          <bpmnos:messages>
            <bpmnos:message name="Request">
              <bpmnos:parameter name="machine" value="machine" />
              <bpmnos:content key="Job" attribute="instance" />
              <bpmnos:content key="Duration" attribute="duration" />
            </bpmnos:message>
          </bpmnos:messages>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_06kzyqb</bpmn2:incoming>
        <bpmn2:outgoing>Flow_1t871bp</bpmn2:outgoing>
      </bpmn2:sendTask>
      <bpmn2:sequenceFlow id="Flow_1t871bp" sourceRef="RequestTask" targetRef="NoticeTaskCompletion" />
      <bpmn2:sequenceFlow id="Flow_05lm3ex" sourceRef="NoticeTaskCompletion" targetRef="JobEndEvent" />
      <bpmn2:receiveTask id="NoticeTaskCompletion" name="Notice task completion">
        <bpmn2:extensionElements>
          <bpmnos:status>
            <bpmnos:operators>
              <bpmnos:operator id="OperatorMakespan" expression="makespan := timestamp" />
            </bpmnos:operators>
          </bpmnos:status>
          <bpmnos:messages>
            <bpmnos:message name="Completion" />
          </bpmnos:messages>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_1t871bp</bpmn2:incoming>
        <bpmn2:outgoing>Flow_05lm3ex</bpmn2:outgoing>
      </bpmn2:receiveTask>
    </bpmn2:subProcess>
    <bpmn2:sequenceFlow id="Flow_1qgy5y7" sourceRef="StartEventItem" targetRef="TaskActivity" />
    <bpmn2:sequenceFlow id="Flow_0xaxr01" sourceRef="TaskActivity" targetRef="Event_0pouiab" />
    <bpmn2:dataObjectReference id="DataObjectReference_0nc3n7b" dataObjectRef="DataObject_1vrduku" />
    <bpmn2:dataObject id="DataObject_1vrduku">
      <bpmn2:extensionElements>
        <bpmnos:attributes>
          <bpmnos:attribute id="Machines" type="collection" name="machines" />
          <bpmnos:attribute id="Durations" type="collection" name="durations" />
        </bpmnos:attributes>
      </bpmn2:extensionElements>
    </bpmn2:dataObject>
  </bpmn2:process>
  <bpmn2:process id="MachineProcess" isExecutable="true">
    <bpmn2:extensionElements>
      <bpmnos:status>
        <bpmnos:attributes>
          <bpmnos:attribute id="Timestamp" type="decimal" name="timestamp" />
        </bpmnos:attributes>
      </bpmnos:status>
    </bpmn2:extensionElements>
    <bpmn2:subProcess id="EventSubProcess" triggeredByEvent="true">
      <bpmn2:extensionElements>
        <bpmnos:status>
          <bpmnos:attributes>
            <bpmnos:attribute id="JobDuration" type="decimal" name="duration" />
            <bpmnos:attribute id="Job" type="string" name="job" />
          </bpmnos:attributes>
          <bpmnos:operators>
            <bpmnos:operator id="OperatorJobRequests" expression="task_requests += 1" />
          </bpmnos:operators>
        </bpmnos:status>
      </bpmn2:extensionElements>
      <bpmn2:sequenceFlow id="Flow_04nmpfp" sourceRef="CatchRequestMessage" targetRef="AdHocSubProcess" />
      <bpmn2:adHocSubProcess id="AdHocSubProcess" ordering="Sequential">
        <bpmn2:incoming>Flow_04nmpfp</bpmn2:incoming>
        <bpmn2:outgoing>Flow_0d3x89n</bpmn2:outgoing>
        <bpmn2:task id="ConductTask" name="Conduct task">
          <bpmn2:extensionElements>
            <bpmnos:status>
              <bpmnos:operators>
                <bpmnos:operator id="Operator_3pf5m16" expression="timestamp += duration" />
              </bpmnos:operators>
            </bpmnos:status>
          </bpmn2:extensionElements>
        </bpmn2:task>
      </bpmn2:adHocSubProcess>
      <bpmn2:sequenceFlow id="Flow_0d3x89n" sourceRef="AdHocSubProcess" targetRef="ThrowCompletionMessage" />
      <bpmn2:startEvent id="CatchRequestMessage" name="Request" isInterrupting="false">
        <bpmn2:extensionElements>
          <bpmnos:message name="Request">
            <bpmnos:parameter name="machine" value="machine" />
            <bpmnos:content key="Duration" attribute="duration" />
            <bpmnos:content key="Job" attribute="job" />
          </bpmnos:message>
        </bpmn2:extensionElements>
        <bpmn2:outgoing>Flow_04nmpfp</bpmn2:outgoing>
        <bpmn2:messageEventDefinition id="MessageEventDefinition_1xfumwd" />
      </bpmn2:startEvent>
      <bpmn2:endEvent id="ThrowCompletionMessage" name="Task completion">
        <bpmn2:extensionElements>
          <bpmnos:message name="Completion">
            <bpmnos:parameter name="recipient" value="job" />
          </bpmnos:message>
        </bpmn2:extensionElements>
        <bpmn2:incoming>Flow_0d3x89n</bpmn2:incoming>
        <bpmn2:messageEventDefinition id="MessageEventDefinition_1fp3b6b" />
      </bpmn2:endEvent>
    </bpmn2:subProcess>
    <bpmn2:dataObject id="DataObject_2xt50y3">
      <bpmn2:extensionElements>
        <bpmnos:attributes>
          <bpmnos:attribute id="Instance" type="string" name="instance" />
        </bpmnos:attributes>
      </bpmn2:extensionElements>
    </bpmn2:dataObject>
    <bpmn2:startEvent id="StartEventMachine">
      <bpmn2:outgoing>Flow_1rghjse</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sequenceFlow id="Flow_1rghjse" sourceRef="StartEventMachine" targetRef="ConditionalEvent" />
    <bpmn2:dataObjectReference id="DataObjectReference_0j8smsl" dataObjectRef="DataObject_0ukass4" />
    <bpmn2:dataObject id="DataObject_0ukass4">
      <bpmn2:extensionElements>
        <bpmnos:attributes>
          <bpmnos:attribute id="Tasks" type="integer" name="tasks" />
          <bpmnos:attribute id="TaskRequests" type="integer" name="task_requests := 0" />
          <bpmnos:attribute id="Machine" type="string" name="machine := instance" />
        </bpmnos:attributes>
      </bpmn2:extensionElements>
    </bpmn2:dataObject>
    <bpmn2:sequenceFlow id="Flow_1y711sx" sourceRef="ConditionalEvent" targetRef="EndEventMachine" />
    <bpmn2:endEvent id="EndEventMachine">
      <bpmn2:incoming>Flow_1y711sx</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:intermediateCatchEvent id="ConditionalEvent" name="All requests obtained">
      <bpmn2:extensionElements>
        <bpmnos:restrictions>
          <bpmnos:restriction id="Condition_05rdls5" expression="task_requests == tasks" />
        </bpmnos:restrictions>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_1rghjse</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1y711sx</bpmn2:outgoing>
      <bpmn2:conditionalEventDefinition id="ConditionalEventDefinition_1wnfoy7">
        <bpmn2:condition xsi:type="bpmn2:tFormalExpression" />
      </bpmn2:conditionalEventDefinition>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:performer name="Sequential" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Job_shop_scheduling_problem">
      <bpmndi:BPMNShape id="Participant_1c07lhk_di" bpmnElement="Participant_1c07lhk" isHorizontal="true">
        <dc:Bounds x="330" y="140" width="770" height="280" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEventItem">
        <dc:Bounds x="392" y="297" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0pouiab_di" bpmnElement="Event_0pouiab">
        <dc:Bounds x="1032" y="297" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0zlnn47_di" bpmnElement="TaskActivity" isExpanded="true">
        <dc:Bounds x="480" y="250" width="490" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1foch6b_di" bpmnElement="JobStartEvent">
        <dc:Bounds x="510" y="297" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1cs1esu_di" bpmnElement="JobEndEvent">
        <dc:Bounds x="912" y="297" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_10lo6wk_di" bpmnElement="RequestTask">
        <dc:Bounds x="600" y="275" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_11bn9oc_di" bpmnElement="NoticeTaskCompletion">
        <dc:Bounds x="760" y="275" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_06kzyqb_di" bpmnElement="Flow_06kzyqb">
        <di:waypoint x="546" y="315" />
        <di:waypoint x="600" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1t871bp_di" bpmnElement="Flow_1t871bp">
        <di:waypoint x="700" y="315" />
        <di:waypoint x="760" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05lm3ex_di" bpmnElement="Flow_05lm3ex">
        <di:waypoint x="860" y="315" />
        <di:waypoint x="912" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="DataObjectReference_0nc3n7b_di" bpmnElement="DataObjectReference_0nc3n7b">
        <dc:Bounds x="392" y="175" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1qgy5y7_di" bpmnElement="Flow_1qgy5y7">
        <di:waypoint x="428" y="315" />
        <di:waypoint x="480" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0xaxr01_di" bpmnElement="Flow_0xaxr01">
        <di:waypoint x="970" y="315" />
